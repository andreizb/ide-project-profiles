{
  "name": "automatic-project-extensions",
  "displayName": "Automatic Project Extensions",
  "description": "Select installed extensions independently for each local workspace.",
  "version": "0.2.0",
  "publisher": "andrei-local",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreizb/ide-project-profiles.git"
  },
  "engines": {
    "vscode": "^1.128.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "disable extensions",
    "extension disabler",
    "extension manager",
    "per workspace",
    "per project",
    "auto disable",
    "profiles",
    "performance",
    "lightweight"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autoDisableExtensions.menu",
        "title": "Show Menu",
        "category": "Auto Disable Extensions"
      },
      {
        "command": "autoDisableExtensions.apply",
        "title": "Apply to This Workspace",
        "category": "Auto Disable Extensions"
      },
      {
        "command": "autoDisableExtensions.redetect",
        "title": "Re-detect Technologies",
        "category": "Auto Disable Extensions"
      },
      {
        "command": "autoDisableExtensions.showReport",
        "title": "Show Extension Report",
        "category": "Auto Disable Extensions"
      },
      {
        "command": "autoDisableExtensions.revert",
        "title": "Enable All Extensions Here",
        "category": "Auto Disable Extensions"
      }
    ],
    "configuration": {
      "title": "Auto Disable Extensions",
      "properties": {
        "autoDisableExtensions.mode": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "off"
          ],
          "enumDescriptions": [
            "Ask before changing a workspace's extensions.",
            "Apply automatically when a workspace is opened.",
            "Only detect; never change anything."
          ],
          "default": "auto",
          "description": "What Auto Disable Extensions does when a workspace needs a different set of extensions. Applying reloads the window."
        },
        "autoDisableExtensions.extensions": {
          "type": "object",
          "default": {
            "anysphere.remote-ssh": "always",
            "anysphere.remote-containers": "always",
            "redhat.java": {
              "languages": [
                "java"
              ],
              "files": [
                "**/pom.xml",
                "**/*.gradle",
                "**/*.gradle.kts",
                "**/.classpath"
              ]
            },
            "james-yu.latex-workshop": {
              "languages": [
                "latex",
                "tex",
                "bibtex",
                "context"
              ],
              "files": [
                "**/*.tex",
                "**/*.ltx",
                "**/*.bib",
                "**/*.sty",
                "**/*.cls"
              ]
            },
            "oracle.sql-developer": {
              "languages": [
                "oracle-sql",
                "sql",
                "apexlang"
              ],
              "files": [
                "**/*.sql",
                "**/*.plsql",
                "**/*.pkb",
                "**/*.pks",
                "**/*.pls",
                "**/*.apx",
                "**/*.apex"
              ]
            }
          },
          "markdownDescription": "Your rules per extension id: `\"always\"`, `\"never\"`, or `{ \"languages\": [], \"files\": [], \"deps\": [] }` (deps like `npm:react`, `cargo:tauri`).",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "always",
                  "never"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "languages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "deps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "replace",
                      "add"
                    ]
                  }
                }
              }
            ]
          }
        },
        "autoDisableExtensions.scanExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "target",
            "dist",
            "build",
            "out",
            "bin",
            "obj",
            ".venv",
            "venv",
            "__pycache__",
            ".next",
            ".nuxt",
            "vendor",
            ".gradle",
            ".idea",
            "coverage"
          ],
          "description": "Folder names skipped while scanning the workspace."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test.cjs"
  },
  "dependencies": {
    "picomatch": "4.0.7",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "@types/node": "22.19.0",
    "@types/picomatch": "3.0.2",
    "@types/vscode": "1.90.0"
  },
  "homepage": "https://github.com/andreizb/ide-project-profiles"
}
